{
    "name": "apiverve/spellchecker",
    "description": "Spell Checker flags misspelled words in submitted English text and generates correction suggestions. It counts total spelling errors and lists possible replacements for each mistaken word.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "spellchecker",
        "spell check api",
        "spell checker api",
        "spell check api correct text",
        "api to check spelling",
        "spelling correction api"
    ],
    "homepage": "https://apiverve.com/marketplace/spellchecker?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/spellchecker",
        "source": "https://github.com/apiverve/spellchecker-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Spellchecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Spellchecker\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
